<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Библиотека — лабораторная работа 3</display-name>

    <servlet>
        <servlet-name>BooksList</servlet-name>

        <servlet-class>lab.web.BooksList</servlet-class>

        <!-- Параметр инициализации сервлета -->
        <init-param>
            <param-name>libraryName</param-name>
            <param-value>Библиотека Ивана Тишко</param-value>
        </init-param>

        <!-- Создать сервлет при запуске приложения -->
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>BooksList</servlet-name>
        <url-pattern>/BooksList</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>